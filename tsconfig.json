{
  "include": ["**/*.ts", "**/*.tsx"],
  "compilerOptions": {
    "target": "ES2022",
    "jsx": "react-jsx",
    "module": "ESNext",
    "lib": ["ES2022", "DOM", "DOM.Iterable"],
    "types": ["vite/client", "@cloudflare/workers-types"],

    /* Bundler mode */
    "moduleResolution": "bundler",
    "allowImportingTsExtensions": true,
    "verbatimModuleSyntax": true,
    "noEmit": true,

    /* Workspace & UI aliases */
    "paths": {
      "@greenshift/core": ["./packages/core/src"],
      "@greenshift/ui": ["./packages/ui/src"],
      "@greenshift/vendor": ["./packages/vendor/src"],
      "@greenshift/investor": ["./packages/investor/src"],
      "@greenshift/broker": ["./packages/broker/src"],
      "@greenshift/business": ["./packages/business/src"],
      "@greenshift/admin": ["./packages/admin/src"],
      "#/atoms": ["./packages/ui/src/atoms"],
      "#/atoms/*": ["./packages/ui/src/atoms/*"],
      "#/molecules": ["./packages/ui/src/molecules"],
      "#/molecules/*": ["./packages/ui/src/molecules/*"],
      "#/organisms": ["./packages/ui/src/organisms"],
      "#/organisms/*": ["./packages/ui/src/organisms/*"],
      "#/lib": ["./packages/ui/src/lib"],
      "#/lib/*": ["./packages/ui/src/lib/*"],
      "#/hooks": ["./packages/ui/src/hooks"],
      "#/hooks/*": ["./packages/ui/src/hooks/*"],
      "#/utils": ["./packages/ui/src/lib/utils"],
      "#/utils/*": ["./packages/ui/src/lib/utils/*"]
    },

    /* Linting */
    "skipLibCheck": true,
    "strict": true,
    "noUnusedLocals": true,
    "noUnusedParameters": true,
    "noFallthroughCasesInSwitch": true,
    "noUncheckedSideEffectImports": true
  }
}
