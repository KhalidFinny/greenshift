{
  "name": "greenshift",
  "private": true,
  "type": "module",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "dev": "vite dev --port 3000",
    "dev:business": "VITE_ROLE=business vite dev --port 3001",
    "dev:vendor": "VITE_ROLE=vendor vite dev --port 3002",
    "dev:investor": "VITE_ROLE=investor vite dev --port 3004",
    "dev:broker": "VITE_ROLE=broker vite dev --port 3005",
    "dev:admin": "VITE_ROLE=admin vite dev --port 3006",
    "generate-routes": "tsr generate",
    "build": "vite build",
    "preview": "vite preview",
    "db:setup": "bun scripts/setup-db.ts",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "drizzle-kit migrate",
    "db:push": "drizzle-kit push",
    "db:pull": "drizzle-kit pull",
    "db:studio": "drizzle-kit studio",
    "typecheck": "tsc --noEmit",
    "format": "biome format",
    "lint": "biome lint",
    "check": "biome check",
    "deploy": "bun run build && wrangler deploy",
    "dev:landing": "VITE_SCOPE=landing vite dev --port 3007",
    "dev:auth": "vite dev --port 3008"
  },
  "dependencies": {
    "@base-ui/react": "^1.6.0",
    "@fontsource-variable/dm-sans": "^5.3.0",
    "@fontsource-variable/ibm-plex-sans": "^5.3.0",
    "@fortawesome/fontawesome-svg-core": "^7.3.1",
    "@fortawesome/free-solid-svg-icons": "^7.3.1",
    "@fortawesome/react-fontawesome": "^3.5.0",
    "@hugeicons/core-free-icons": "^4.2.3",
    "@hugeicons/react": "^1.1.9",
    "@tailwindcss/vite": "^4.1.18",
    "@tanstack/react-devtools": "latest",
    "@tanstack/react-form": "^1.33.2",
    "@tanstack/react-query": "latest",
    "@tanstack/react-query-devtools": "latest",
    "@tanstack/react-router": "latest",
    "@tanstack/react-router-devtools": "latest",
    "@tanstack/react-router-ssr-query": "latest",
    "@tanstack/react-start": "latest",
    "@tanstack/react-table": "^8.21.3",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "drizzle-kit": "^0.31.9",
    "drizzle-orm": "^0.45.1",
    "hono": "^4.13.3",
    "lucide-react": "^1.34.0",
    "react": "^19.2.0",
    "react-aria-components": "^1.19.0",
    "react-dom": "^19.2.0",
    "shadcn": "^4.14.1",
    "tailwind-merge": "^3.0.2",
    "tailwindcss": "^4.1.18",
    "tw-animate-css": "^1.3.6"
  },
  "devDependencies": {
    "@biomejs/biome": "2.4.5",
    "@cloudflare/vite-plugin": "^1.26.0",
    "@cloudflare/workers-types": "^5.20260823.1",
    "@greenshift/admin": "workspace:*",
    "@greenshift/broker": "workspace:*",
    "@greenshift/business": "workspace:*",
    "@greenshift/core": "workspace:*",
    "@greenshift/investor": "workspace:*",
    "@greenshift/ui": "workspace:*",
    "@greenshift/vendor": "workspace:*",
    "@tailwindcss/typography": "^0.5.16",
    "@tanstack/devtools-vite": "latest",
    "@tanstack/router-cli": "^1.132.0",
    "@tanstack/router-core": "1.171.15",
    "@types/node": "^22.10.2",
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "@vitejs/plugin-react": "^6.0.1",
    "dotenv": "^17.3.1",
    "tsx": "^4.21.0",
    "typescript": "^6.0.2",
    "vite": "^8.0.0",
    "wrangler": "^4.70.0",
    "@greenshift/api": "workspace:*",
    "@greenshift/landing": "workspace:*"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "esbuild",
      "lightningcss",
      "sharp",
      "workerd"
    ]
  }
}
