{
	"extends": "../../tsconfig.json",
	"compilerOptions": {
		"baseUrl": ".",
		"paths": {
			"#/atoms": ["./src/atoms"],
			"#/atoms/*": ["./src/atoms/*"],
			"#/molecules": ["./src/molecules"],
			"#/molecules/*": ["./src/molecules/*"],
			"#/organisms": ["./src/organisms"],
			"#/organisms/*": ["./src/organisms/*"],
			"#/lib": ["./src/lib"],
			"#/lib/*": ["./src/lib/*"],
			"#/hooks": ["./src/hooks"],
			"#/hooks/*": ["./src/hooks/*"],
			"#/utils": ["./src/lib/utils"],
			"#/utils/*": ["./src/lib/utils/*"]
		}
	},
	"include": ["src/**/*"]
}
