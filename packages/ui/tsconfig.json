{
	"extends": "../../tsconfig.json",
	"compilerOptions": {
		"baseUrl": ".",
		"paths": {
			"#/components": ["./src/components"],
			"#/components/*": ["./src/components/*"],
			"#/ui": ["./src/components/ui"],
			"#/ui/*": ["./src/components/ui/*"],
			"#/lib": ["./src/lib"],
			"#/lib/*": ["./src/lib/*"],
			"#/hooks": ["./src/hooks"],
			"#/hooks/*": ["./src/hooks/*"],
			"#/utils": ["./src/lib/utils"],
			"#/utils/*": ["./src/lib/utils/*"]
		}
	},
	"include": ["src/**/*"]
}
